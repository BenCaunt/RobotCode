---
import "@fontsource-variable/inter";
import hero from "../../../../../.github/readme/hero.webp";
import icon from "../../../../../assets/prod/logo.svg?url";
import { LOCALES, localeStaticPaths } from "../../i18n/locales";
import { copy } from "../../i18n/robot-code";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
const [title, description, build, credit] = copy[locale];
const source = "https://github.com/BenCaunt/RobotCode";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#073e40" />
    <meta name="description" content={description} />
    <meta property="og:title" content="Robot Code" />
    <meta property="og:description" content={title} />
    <meta property="og:image" content={hero.src} />
    <link rel="icon" href={icon} type="image/svg+xml" />
    <title>Robot Code</title>
  </head>
  <body>
    <main>
      <img class="cover" src={hero.src} alt="Robot Code" width={hero.width} height={hero.height} />
      <section>
        <h1>{title}</h1>
        <div>
          <p>{description}</p>
          <a class="build" href={source + "#run-from-source"}>{build} <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <footer>
        <p>{credit}</p>
        <nav>
          {LOCALES.map((language) => <a href={`/${language.path}`} lang={language.code} hreflang={language.code} aria-current={language.code === locale ? "page" : undefined}>{language.name}</a>)}
        </nav>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { background: #073e40; color: #ffe7ba; margin: 0; font-family: "Inter Variable", system-ui, sans-serif; }
  main { max-width: 86rem; margin: auto; padding: clamp(1rem, 4vw, 4rem); }
  .cover { display: block; width: 100%; height: auto; border-bottom: 3px solid #ff823f; }
  section { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 6vw, 6rem); padding: 3rem 0; }
  h1 { margin: 0; max-width: 20ch; font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1.05; letter-spacing: -.045em; }
  p { margin: 0; line-height: 1.55; }
  section p { font-size: 1.15rem; }
  .build { display: inline-block; margin-top: 1.5rem; padding: .8rem 1.2rem; background: #ffe7ba; color: #073e40; text-decoration: none; font-weight: 700; }
  .build:hover { background: #ffad73; }
  footer { border-top: 1px solid #73948d; padding: 1.5rem 0; font-size: .9rem; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  nav a { color: inherit; text-underline-offset: .2em; }
  nav [aria-current] { font-weight: bold; }
  @media (max-width: 40rem) { section { grid-template-columns: 1fr; gap: 1rem; padding: 2rem 0; } }
</style>
